# pi-net-watchdog.service -- runs the check script once per timer tick
[Unit]
Description=Hatoba Pi network watchdog (one check)
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=hiroki
# Dry-run was on for the first morning (2026-11-24) and removed the
# same day with the user's approval: this unit is LIVE. To go back to
# dry-run, add Environment=NET_WATCHDOG_DRY_RUN=1 here, daemon-reload.
ExecStart=/bin/sh /home/hiroki/myos/Hatoba/daemon/pi-net-watchdog.sh
